{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"]
  },
  "include": [
    "tools/**/*.ts",
    "packages/*/src/**/*.ts",
    "workers/*/src/**/*.ts",
    "workers/*/worker-configuration.d.ts"
  ]
}
