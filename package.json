{
  "name": "ay-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified Cloudflare monorepo, upstream fork sync, FinOps, tunnels, Mullvad VPN, proxy VPS, and polyglot edge toolchain",
  "license": "Apache-2.0",
  "author": "aphrody-dev <contact@aphrody.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-dev/ay-cf.git"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun test packages workers tools",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test packages workers tools",
    "audit": "bun tools/audit.ts --strict",
    "finops": "bun tools/finops.ts",
    "reconcile": "bun tools/reconcile.ts",
    "cluster-proxy": "bun tools/cluster-proxy.ts",
    "private-gate": "bun tools/private-gate.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "cloudflare": "7.3.0",
    "hono": "4.13.19",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "wrangler": "4.164.0"
  },
  "patchedDependencies": {
    "jsonc-parser@3.3.1": "patches/jsonc-parser@3.3.1.patch"
  }
}
